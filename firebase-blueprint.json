{
  "entities": {
    "Workspace": {
      "title": "Workspace",
      "description": "Tenant workspace configuration and business profile settings.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "description": "UID of the workspace owner.",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "description": "Workspace or business display name.",
          "maxLength": 100,
          "minLength": 1
        },
        "category": {
          "type": "string",
          "description": "Primary business segment.",
          "enum": ["creator", "freelancer", "coach", "agency", "smb"]
        },
        "timezone": {
          "type": "string",
          "description": "IANA timezone identifier.",
          "maxLength": 64,
          "minLength": 1
        },
        "currency": {
          "type": "string",
          "description": "ISO currency code.",
          "enum": ["USD", "EUR", "GBP", "NGN", "CAD"]
        },
        "senderName": {
          "type": "string",
          "description": "Default sender identity name.",
          "maxLength": 100,
          "minLength": 1
        },
        "whatsappConnected": {
          "type": "boolean",
          "description": "Whether Official WhatsApp Cloud API credentials are configured."
        },
        "smsConnected": {
          "type": "boolean",
          "description": "Whether compliant SMS provider credentials are configured."
        },
        "emailConnected": {
          "type": "boolean",
          "description": "Whether compliant Email API/SMTP provider is configured."
        },
        "notifyNewLeads": {
          "type": "boolean",
          "description": "Receive notifications on new lead capture."
        },
        "notifyCampaigns": {
          "type": "boolean",
          "description": "Receive notifications on campaign completion."
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation server timestamp."
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update server timestamp."
        }
      },
      "required": [
        "ownerId",
        "name",
        "category",
        "timezone",
        "currency",
        "senderName",
        "whatsappConnected",
        "smsConnected",
        "emailConnected",
        "notifyNewLeads",
        "notifyCampaigns",
        "createdAt",
        "updatedAt"
      ]
    },
